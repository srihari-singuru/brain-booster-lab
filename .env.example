# Local settings template. Copy this file to .env, edit it locally, then run:
# set -a; source .env; set +a
POSTGRES_PASSWORD=brain_booster_dev

# Keep local development keyless. Set GENERATION_MODE=live only when an API key is available.
GENERATION_MODE=mock
OPENAI_MODEL=gpt-6-astra
# Optional: leave blank to use GENERATION_MODE and OPENAI_MODEL for the narration writer/editor.
NARRATION_MODE=
NARRATION_MODEL=
# Optional: blank mode inherits GENERATION_MODE. The default model and voice are the recommended expressive TTS setup.
SPEECH_MODE=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
# Keep local development artwork keyless. Set ARTWORK_MODE=live only when an API key is available.
ARTWORK_MODE=mock
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_API_KEY=your-key-here
